 #define TEST_FILE TMP_DIR"/testfile"
@@ -60,7 +61,7 @@ static void dirtyc0w_shmem_test(void)
 	int pid;
 	char c;
 
-	SAFE_FILE_PRINTF(TEST_FILE, STR);
+	SAFE_FILE_PRINTF_PGSIZE_EMULATION(TEST_FILE, STR);
 	SAFE_CHMOD(TEST_FILE, 0444);
 
 	pid = SAFE_FORK();
